# =============================================================================
# RAF - Reverse proxy HTTPS (voir docker-compose.prod.yml).
#
# Caddy obtient et renouvelle seul les certificats. Il remplace tout
# X-Forwarded-For envoye par le client par l'IP reelle de celui-ci : derriere
# lui, le backend et nginx peuvent s'y fier.
# =============================================================================

{
	email {$ACME_EMAIL}
}

(securite) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Site vitrine et back-office. Le back-office appelle /api sur cette meme
# origine : pas de CORS, pas d'adresse du backend dans le code du site.
{$SITE_DOMAIN} {
	import securite
	request_body {
		max_size 10MB
	}
	handle /api/* {
		reverse_proxy backend:8081
	}
	handle {
		reverse_proxy frontend:4000
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# App joueur : nginx sert la PWA et les images, et relaie /api au backend.
{$APP_DOMAIN} {
	import securite
	reverse_proxy player:80
}
