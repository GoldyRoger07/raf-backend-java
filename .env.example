# ================================================================
# TEMPLATE Docker - copie ce fichier en .env et remplis les valeurs.
# docker compose le lit automatiquement. Seul CE fichier est commite.
# ================================================================

# --- Profil Spring ------------------------------------------------
# prod : emails reels (Resend), Swagger coupe. dev : logs SQL, emails en console.
APP_ENV=prod

# --- MySQL (conteneur) ---------------------------------------------
# Le backend s'y connecte avec MYSQL_USER / MYSQL_PASSWORD : DB_URL,
# DB_USERNAME et DB_PASSWORD sont construits par docker-compose.yml.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=raf
MYSQL_USER=raf
MYSQL_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10

# --- Ports exposes sur la machine ------------------------------------
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=4000
PLAYER_HOST_PORT=8100
# Noms d'hote acceptes par le serveur du site, separes par des virgules.
FRONTEND_ALLOWED_HOSTS=localhost

# --- JWT ---------------------------------------------------------
# Minimum 32 caracteres pour HS256. A regenerer pour chaque environnement.
JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM
# Duree de vie : accepte un suffixe (15m, 1h, 30d) ou un nombre en millisecondes.
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# --- URLs --------------------------------------------------------
APP_BASE_URL=http://localhost:8081
APP_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000,http://localhost:4200,http://localhost:8100

# --- Email : Resend (https://resend.com) --------------------------
# MAIL_MODE=console (defaut) : aucun envoi, l'email s'affiche dans la console
# du serveur avec ses liens. MAIL_MODE=resend : envoi reel (defaut du profil prod).
MAIL_MODE=console
RESEND_API_KEY=
MAIL_FROM=contact@rafhaiti.com

# --- Web Push (VAPID) ---------------------------------------------
# Regenerer pour la production : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:contact@rafhaiti.com

# --- Premier administrateur ---------------------------------------
# Renseigner une seule fois au premier demarrage, puis vider ces valeurs.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Medias (images) ------------------------------------------------
# Les images sont ecrites dans le volume media-data et servies par nginx
# (conteneur player). Adresse publique de ce dossier, sans / final.
MEDIA_PUBLIC_URL=http://localhost:8100/media

# --- Generation de questions par IA -------------------------------
# none (desactivee), anthropic, ou openai (toute API compatible OpenAI).
# Exemples : AI_PROVIDER=anthropic + AI_API_KEY (console.anthropic.com) ;
#            AI_PROVIDER=openai + AI_BASE_URL=https://api.mistral.ai/v1 + AI_MODEL + AI_API_KEY ;
#            AI_PROVIDER=openai + AI_BASE_URL=http://localhost:11434/v1 + AI_MODEL (Ollama, sans cle).
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
